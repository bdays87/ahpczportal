<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>

  <appSettings>
    <!-- Where this bridge listens. Keep it bound to localhost — this box is the
         only thing that should ever reach the Sage company database, and the
         Laravel app calls in over the LAN/localhost, not the public internet. -->
    <add key="ListenPrefix" value="http://127.0.0.1:8990/" />

    <!-- Shared secret the Laravel app must send as the X-Api-Key header.
         Generate a long random value and put the same one in Laravel's .env
         as SAGE_BRIDGE_API_KEY. -->
    <add key="ApiKey" value="CHANGE-ME-TO-A-LONG-RANDOM-SECRET" />

    <!-- Evolution login — same values you'd type into the Evolution login
         screen for this company. See SageSession.cs: these are passed to
         DatabaseContext.Initialise / SetLicense. Confirm the exact parameter
         order against your SDK Developer Guide — Initialise has a few
         overloads and the guide's sample project is the source of truth. -->
    <add key="Evolution.CompanyName" value="" />
    <add key="Evolution.Agent" value="" />
    <add key="Evolution.Password" value="" />
    <add key="Evolution.Server" value="" />
    <add key="Evolution.LicenseSerial" value="" />
    <add key="Evolution.LicenseKey" value="" />

    <!-- Folder for the bridge's own request/error log. -->
    <add key="LogPath" value="C:\laragon\www\anix\ahpczportal\sageintegration\SageBridge\logs\bridge.log" />
  </appSettings>
</configuration>
